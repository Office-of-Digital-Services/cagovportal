{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Service finder categories",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["categoryId", "name"],
    "properties": {
      "categoryId": { "type": "integer" },
      "name": { "type": "string", "pattern": "\\S" }
    }
  }
}
