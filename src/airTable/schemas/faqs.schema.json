{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SEP FAQs",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["Id", "AgencyServiceId", "Question", "Answer", "SortOrder"],
    "properties": {
      "Id": { "type": "integer" },
      "AgencyServiceId": { "type": "integer" },
      "Question": { "type": "string", "pattern": "\\S" },
      "Answer": { "type": "string", "pattern": "\\S" },
      "SortOrder": { "type": "number" },
      "Featured": { "type": "boolean" },
      "Updated": { "type": "string" }
    }
  }
}
