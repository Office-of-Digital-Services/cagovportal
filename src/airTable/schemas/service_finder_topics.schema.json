{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Service finder topics",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["TopicId", "CategoryId", "Name", "Caption"],
    "properties": {
      "TopicId": { "type": "integer" },
      "CategoryId": { "type": "integer" },
      "Name": { "type": "string", "pattern": "\\S" },
      "Caption": { "type": "string", "pattern": "\\S" }
    }
  }
}
