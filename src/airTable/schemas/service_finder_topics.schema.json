{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Service finder topics",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["topicID", "categoryID", "name", "caption"],
    "properties": {
      "topicID": { "type": "integer" },
      "categoryID": { "type": "integer" },
      "name": { "type": "string", "pattern": "\\S" },
      "caption": { "type": "string", "pattern": "\\S" }
    }
  }
}
