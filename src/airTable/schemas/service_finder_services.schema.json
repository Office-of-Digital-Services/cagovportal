{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Service finder services",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["serviceId"],
    "properties": {
      "serviceId": { "type": "integer" },
      "shortDescription": { "type": "string" },
      "subtopicIds": {
        "type": "array",
        "items": { "type": "integer" }
      }
    }
  }
}
